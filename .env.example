# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# ─────────── ĐƯỜNG TEXT: chatbot · ô tìm kiếm · Q&A · semantic extraction ───────────
#
# ⚠️ CẤU HÌNH THẬT ĐÃ LỆCH §7.0 của BACKEND.md, có chủ đích và đã đo.
# §7.0 ghim `claude-fable-5`; đo 15/8/2026: model đó chỉ về 1/6 lượt và lượt về
# mất 48,1s, tức gần như không bao giờ kịp trong timeout. Đọc §7.0 rồi tưởng
# đang chạy fable-5 là hiểu sai.
#
# ⚠️ ĐÃ ĐỔI GATEWAY HAI LẦN. Ghi lại để không ai đọc số cũ của gateway cũ:
#   codex + claude-fable-5              1/6 lượt về, 48,1s      (bỏ)
#   vertex-key + sonnet-5-medium        trung vị 6,5s           (khoá hết hạn)
#   codex + claude-sonnet-5             trung vị 31,6s          (hiện tại)
#
# Gateway hiện tại KHÔNG có biến thể `-low/-medium/-high`, và mặc định bật suy
# luận sâu — đó là toàn bộ nguyên nhân của 30 giây chờ. Xem LLM_REASONING_EFFORT
# ở cuối tệp; đừng vá bằng cách hạ LLM_TIMEOUT_MS.
LLM_PROVIDER=openai
LLM_API_BASE=https://codex.hungnguyen.codes/v1
LLM_BASE_URL=https://codex.hungnguyen.codes/v1
LLM_API_KEY=sk-...
CHAT_MODEL=claude-sonnet-5
RISK_LLM_MODEL=claude-sonnet-5
LLM_MODEL=claude-sonnet-5

# ⚠️ ĐỪNG HẠ SỐ NÀY ĐỂ "CHO NHANH". Đo 16/8/2026: trần 12s làm hỏng 100% lượt
# gọi và recall rơi từ 67,6% về mức chỉ-bộ-luật 3,8%. Chờ nhanh mà mù thì tệ hơn
# chờ lâu mà thấy. Muốn nhanh thì hạ LLM_REASONING_EFFORT, và giao diện đã có
# đường /api/analyze/so-bo trả kết quả tầng luật dưới 100ms.
LLM_TIMEOUT_MS=35000

# ─────────── ĐƯỜNG ẢNH: icon · nhãn dán · linh vật · mockup 3D ───────────
# Gateway RIÊNG, khoá RIÊNG. Dù trước đây chung credential, KHÔNG gộp hai đường
# vào một module cấu hình (§7.0).
# Tuyệt đối không chạm vào OCR / Risk Signal Engine / Rule Engine / xác thực link.
IMAGE_API_BASE=https://codex.hungnguyen.codes/v1
IMAGE_API_KEY=sk-...
IMAGE_MODEL=gpt-image-1.5

PORT=8089

# Mức suy luận của tầng trích tín hiệu. Mặc định `low`.
#
# ⚠️ Đo 16/8/2026 trên codex.hungnguyen.codes: mức mặc định của gateway sinh
# ~2.700 token mỗi lượt, mà nội dung trả lời chỉ ~400 — phần còn lại là token
# suy luận, và nó là 30 giây người dùng phải chờ. `low` cho 6,7s thay vì 23,5s.
#
# Và nó KHÔNG phải đánh đổi: trên lát 64 mẫu, `low` cho recall 71,9% so với
# 62,5% của mức mặc định, high-risk FP không đổi. Trích tín hiệu là việc QUAN
# SÁT có bằng chứng (§4.2), không phải việc cân nhắc — suy luận sâu làm model tự
# vấn rồi bỏ bớt tín hiệu.
#
# Đặt `tat` để không gửi tham số, để gateway tự quyết.
# ⚠️ Đổi giá trị này là ĐỔI PHÉP ĐO — khoá đệm của bộ đánh giá có mang nó.
LLM_REASONING_EFFORT=low
