{
  "name": "khoan-da-24h",
  "private": true,
  "version": "1.0.0",
  "description": "Khoan Đã — phát hiện tin nhắn lừa đảo. Bộ luật quyết định, AI chỉ trích tín hiệu.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "check": "node scripts/kiem-cu-phap.js",
    "eval": "node eval/run.js",
    "eval:ghi": "node eval/run.js --ghi",
    "eval:quocte": "node eval/khoanbench.js",
    "eval:quocte:ghi": "node eval/khoanbench.js --ghi"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
